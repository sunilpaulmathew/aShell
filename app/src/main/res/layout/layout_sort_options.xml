<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="15dp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_width="match_parent"
    android:paddingHorizontal="15dp"
    android:layout_gravity="center"
    android:orientation="vertical" >

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?android:attr/colorControlNormal"
        android:layout_marginVertical="10dp"
        android:alpha="0.2" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_type_show"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
        android:textColor="?android:attr/colorPrimary"
        android:textStyle="bold"
        android:textSize="15sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/showApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true" >

        <com.google.android.material.chip.Chip
            android:id="@+id/all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_type_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/system"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_type_system" />

        <com.google.android.material.chip.Chip
            android:id="@+id/user"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_type_user" />

        <com.google.android.material.chip.Chip
            android:id="@+id/disabled"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_type_disabled" />
    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:background="?android:attr/colorControlNormal"
        android:layout_marginVertical="10dp"
        android:alpha="0.2" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/reverseOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reverse_order"
        android:textStyle="bold"
        android:textSize="15sp" />

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?android:attr/colorControlNormal"
        android:layout_marginVertical="10dp"
        android:alpha="0.2" />
</androidx.appcompat.widget.LinearLayoutCompat>